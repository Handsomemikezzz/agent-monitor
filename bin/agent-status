#!/usr/bin/python3 -IS
"""agent-status: a menu bar light for your coding agents' sessions.

Subcommands
  hook <agent> [event]  called by the agents' hooks; reads the event JSON on stdin
  status                sessions to show, as JSON (what the menu bar app reads)
  dump                  every stored record, as JSON, for debugging
  open <key>            jumps back to a session and marks it seen
  seen-all              marks every finished session as seen
  install / uninstall   adds or removes the hooks and the menu bar app
  trust-codex           asks you, then marks the hooks trusted in Codex

Only the Python standard library is used, so it runs on the system /usr/bin/python3.
"""

import calendar
import fcntl
import glob
import json
import os
import subprocess
import sys
import time

STATE_DIR = os.path.expanduser(os.environ.get("AGENT_STATUS_DIR", "~/.agent-status"))
SELF = os.path.realpath(__file__)
ROOT = os.path.dirname(os.path.dirname(SELF))
APP = os.path.join(ROOT, "build", "Agent Status.app")
AGENT_LABEL = "io.github.agent-status"
LAUNCH_AGENT = os.path.expanduser("~/Library/LaunchAgents/%s.plist" % AGENT_LABEL)
HOOK_MARKER = "agent-status\" hook"  # how our hook commands are recognised on uninstall

# A session's state only ever comes from the agents and the apps, never from a timer.
# The one time limit is housekeeping: how far back to look for sessions we have no
# record of yet, and when to delete records that are no longer shown.
RECENT = 24 * 3600

CODEX_HOME = os.environ.get("CODEX_HOME", "~/.codex")
T3_USERDATA = os.environ.get("T3_USERDATA", "~/.t3/userdata")

CLAUDE_BUNDLE = "com.anthropic.claudefordesktop"
CLAUDE_CLI_BUNDLE = "com.anthropic.claude-code"  # the CLI itself ships as an .app
CODEX_BUNDLE = "com.openai.codex"
T3_BUNDLE = "com.t3tools.t3code"
ANTIGRAVITY_BUNDLES = ("com.google.antigravity", "com.google.antigravity-ide")

ASK_TOOLS = {"AskUserQuestion", "ExitPlanMode"}
WAIT_NOTIFICATIONS = {
    "permission_prompt", "worker_permission_prompt",
    "elicitation_dialog", "elicitation_url_dialog", "agent_needs_input",
}

# What each session counts as, in badge order: red, green, blue, grey.
# "read" (finished and seen, or interrupted) is kept on disk but not shown.
KINDS = ("waiting", "running", "unread")
# ---------------------------------------------------------------- state files

def _path(key):
    return os.path.join(STATE_DIR, key + ".json")


def _safe(s):
    return "".join(c if c.isalnum() or c in "-_" else "_" for c in str(s))[:100]


def load(key):
    try:
        with open(_path(key)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save(key, rec):
    tmp = _path(key) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(rec, f, ensure_ascii=False)
    os.replace(tmp, _path(key))


def remove(key):
    try:
        os.remove(_path(key))
    except OSError:
        pass


def all_records():
    out = []
    try:
        names = os.listdir(STATE_DIR)
    except OSError:
        return out
    for name in names:
        if name.endswith(".json"):
            rec = load(name[:-5])
            if rec:
                rec["_key"] = name[:-5]
                out.append(rec)
    return out


class Lock:
    def __enter__(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        self.f = open(os.path.join(STATE_DIR, ".lock"), "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def color_of(rec):
    """What a single session counts as: waiting / running / unread / read."""
    st = rec.get("state")
    if st == "waiting":
        return "waiting"
    if st == "running":
        return "running"
    if st == "done" and not rec.get("seen"):
        return "unread"
    return "read"  # finished and seen, or interrupted


# ---------------------------------------------------------------- state machine
#
# Every agent's hook events are first translated (by its adapter, below) into one of
# these, so the rules for what each one means live in one place:
#
#   start      a session started or was resumed: not a new turn by itself
#   prompt     you sent a message: a turn starts
#   working    the agent is at work (for agents with no prompt event)
#   wait       it needs you: an approval, a question, a plan (reason says which)
#   wait_hint  a weaker "needs you" signal, used only if nothing better came first
#   tool_done  a tool finished: an approval or question was answered
#   turn_done  the turn finished
#   interrupt  the turn was stopped
#   end        the session closed

def next_state(kind, reason, cur):
    """(state, reason) for a translated event, None to leave the state, or 'ended'."""
    st = cur.get("state") if cur else None
    if kind == "prompt" or kind == "working":
        return ("running", "")
    if kind == "start":
        # Also sent when an app resumes an old session or a turn compacts. A session
        # we don't know yet gets its state from its transcript.
        if cur and not cur.get("hidden"):
            return None
        return (st, cur.get("reason", "") if cur else "")
    if kind == "wait":
        return ("waiting", reason or "permission")
    if kind == "wait_hint":
        return ("waiting", "permission") if st not in ("done", "waiting") else None
    if kind == "tool_done":
        # Never overrides a finished turn.
        return ("running", "") if st in ("waiting", "idle") else None
    if kind == "turn_done":
        return ("done", "")
    if kind == "interrupt":
        return ("idle", "interrupted")
    if kind == "end":
        return "ended"
    return None


def debug_log(tool, data):
    if not os.path.exists(os.path.join(STATE_DIR, ".debug")):
        return
    keep = {k: (v if k not in ("prompt", "tool_input", "tool_response", "last_assistant_message",
                              "message", "lastUserInput", "toolCall")
                else "<%d chars>" % len(json.dumps(v, ensure_ascii=False)))
            for k, v in data.items()}
    env = {k: os.environ.get(k) for k in ("CLAUDE_CODE_HOST_SESSION_ID", "CLAUDE_CODE_ENTRYPOINT",
                                         "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
                                         "ANTIGRAVITY_CONVERSATION_ID",
                                         "__CFBundleIdentifier", "TERM_PROGRAM")
           if os.environ.get(k)}
    with open(os.path.join(STATE_DIR, "debug.log"), "a") as f:
        f.write(json.dumps({"t": time.strftime("%H:%M:%S"), "tool": tool, "data": keep,
                            "env": env}, ensure_ascii=False) + "\n")


def cmd_hook(tool, raw, event=""):
    agent = AGENTS.get(tool)
    try:
        data = json.loads(raw) if raw.strip() else {}
    except ValueError:
        return
    if not agent or not isinstance(data, dict):
        return
    os.makedirs(STATE_DIR, exist_ok=True)
    if event:
        data.setdefault("hook_event_name", event)
    debug_log(tool, data)
    ev = agent.translate(data.get("hook_event_name") or "", data)
    if not ev or not ev.get("sid"):
        return
    key = "%s-%s" % (tool, _safe(ev["sid"]))
    with Lock():
        cur = load(key)
        nxt = next_state(ev["kind"], ev.get("reason", ""), cur)
        if nxt is None:
            return
        if nxt == "ended":
            # Kept, hidden, so the transcript scan doesn't bring it back. Not for app
            # sessions: the apps end them on every quit and resume them later, and
            # archiving is what really closes them there. But the process is gone,
            # so a turn that was running or waiting has stopped.
            if cur and (cur.get("jump") or {}).get("kind") == "url":
                if cur.get("state") in ("running", "waiting"):
                    cur.update(state="idle", reason="", updated_at=int(time.time()), since=int(time.time()))
                    cur.pop("detail", None)
                    save(key, cur)
                return
            if cur and not cur.get("hidden"):
                cur["hidden"] = True
                save(key, cur)
            return
        state, reason = nxt
        rec = dict(cur or {})
        rec.pop("hidden", None)
        if ev.get("transcript"):
            rec["transcript"] = ev["transcript"]
        cwd = ev.get("cwd") or rec.get("cwd") or ""
        if state != rec.get("state") or "since" not in rec:
            # When it entered this state. The panel sorts by it, so a running session
            # doesn't jump around (under your mouse) on every tool call.
            rec["since"] = int(time.time())
        if ev["kind"] in ("start", "prompt", "working") or "pid" not in rec:
            rec.update(agent.process() or {})
        rec.update({
            "tool": tool,
            "session_id": ev["sid"],
            "state": state,
            "reason": reason,
            "cwd": cwd,
            "title": os.path.basename(cwd.rstrip("/")) or agent.label,
            "updated_at": int(time.time()),
        })
        jump = agent.jump(ev["sid"], data)
        # A deep link found once is better than a later, vaguer guess.
        if jump["kind"] == "url" or (rec.get("jump") or {}).get("kind") != "url":
            rec["jump"] = jump
        if state == "waiting" and ev.get("detail"):
            rec["detail"] = ev["detail"]
        elif state != "waiting":
            rec.pop("detail", None)
        if ev.get("prompt"):
            rec["prompt"] = ev["prompt"]
        if state == "done":
            rec["seen"] = False
            rec.pop("seen_at", None)
            if agent.on_screen(rec):
                rec["seen"], rec["seen_at"] = True, int(time.time())
        elif state in ("running", "idle"):
            rec["seen"] = True
        save(key, rec)


# ---------------------------------------------------------------- helpers for adapters

def _iso(ts):
    try:
        return calendar.timegm(time.strptime(str(ts)[:19].replace(" ", "T"), "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return 0


def _tail(path, size=256 * 1024):
    """The last lines of a file, newest first."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            n = f.tell()
            f.seek(max(0, n - size))
            lines = f.read().split(b"\n")
    except OSError:
        return []
    return (lines[1:] if n > size else lines)[::-1]


def _first_line(text):
    text = (text or "").strip() if isinstance(text, str) else ""
    return text.splitlines()[0][:60] if text else ""


def _frontmost():
    try:
        asn = subprocess.run(["/usr/bin/lsappinfo", "front"], capture_output=True,
                             text=True, timeout=1).stdout.strip()
        out = subprocess.run(["/usr/bin/lsappinfo", "info", "-only", "bundleid", asn],
                             capture_output=True, text=True, timeout=1).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return out.rsplit("=", 1)[-1].strip().strip('"') or None


def _sqlite_rows(pattern, query, params, default=()):
    """Rows from the newest read-only SQLite file matching `pattern`, or `default` if
    there's none or its schema isn't what we expect (it's another app's, and may change)."""
    import sqlite3
    import urllib.request
    dbs = glob.glob(os.path.expanduser(pattern))
    if not dbs:
        return default
    db = max(dbs, key=os.path.getmtime)
    try:
        con = sqlite3.connect("file:%s?mode=ro" % urllib.request.pathname2url(db), uri=True, timeout=1)
        rows = con.execute(query, params).fetchall()
        con.close()
        return rows
    except Exception:
        return default


def _local_storage(path, key):
    """A value from a Chromium app's Local Storage (a LevelDB folder), or None if it
    can't be read. Reads the files directly; only enough of LevelDB for that."""
    import struct

    def varint(b, i):
        r = s = 0
        while True:
            x = b[i]
            i += 1
            r |= (x & 0x7F) << s
            s += 7
            if x < 0x80:
                return r, i

    def snappy(b):
        _, i = varint(b, 0)
        out = bytearray()
        while i < len(b):
            t, k = b[i], b[i] & 3
            i += 1
            if k == 0:  # literal
                n = t >> 2
                if n >= 60:
                    n, i = int.from_bytes(b[i:i + n - 59], "little"), i + n - 59
                out += b[i:i + n + 1]
                i += n + 1
                continue
            if k == 1:
                n, off, i = ((t >> 2) & 7) + 4, ((t >> 5) << 8) | b[i], i + 1
            else:
                w = 2 if k == 2 else 4
                n, off, i = (t >> 2) + 1, int.from_bytes(b[i:i + w], "little"), i + w
            for _ in range(n):
                out.append(out[-off])
        return bytes(out)

    def entries(block):
        restarts = struct.unpack("<I", block[-4:])[0]
        end, i, k = len(block) - 4 - 4 * restarts, 0, b""
        while i < end:
            shared, i = varint(block, i)
            fresh, i = varint(block, i)
            n, i = varint(block, i)
            k = k[:shared] + block[i:i + fresh]
            i += fresh
            yield k, block[i:i + n]
            i += n

    def table(f):  # an .ldb file: index block -> data blocks of internal keys
        def read(h):
            off, j = varint(h, 0)
            size, _ = varint(h, j)
            f.seek(off)
            raw = f.read(size + 1)
            return snappy(raw[:size]) if raw[size] == 1 else raw[:size]
        f.seek(-48, 2)
        foot = f.read(48)
        _, j = varint(foot, 0)
        _, j = varint(foot, j)
        for _, handle in entries(read(foot[j:])):
            for ik, v in entries(read(handle)):
                tag = struct.unpack("<Q", ik[-8:])[0]
                yield ik[:-8], tag >> 8, tag & 0xFF, v

    def log(f):  # a .log file: write batches split into 32 KB blocks
        data, i, batch, batches = f.read(), 0, b"", []
        while i + 7 <= len(data):
            if 32768 - i % 32768 < 7:
                i += 32768 - i % 32768
                continue
            n, kind = struct.unpack("<H", data[i + 4:i + 6])[0], data[i + 6]
            batch = (batch if kind in (3, 4) else b"") + data[i + 7:i + 7 + n]
            if kind in (1, 4):
                batches.append(batch)
            i += 7 + n
        for b in batches:
            seq, count = struct.unpack("<QI", b[:12])
            j = 12
            for n in range(count):
                kind = b[j]
                size, j = varint(b, j + 1)
                k, j = b[j:j + size], j + size
                v = b""
                if kind == 1:
                    size, j = varint(b, j)
                    v, j = b[j:j + size], j + size
                yield k, seq + n, kind, v

    want = b"_https://claude.ai\x00\x01" + key.encode()
    best = None
    try:
        for name in os.listdir(path):
            if name.endswith((".ldb", ".log")):
                with open(os.path.join(path, name), "rb") as f:
                    for k, seq, kind, v in (table(f) if name.endswith(".ldb") else log(f)):
                        if k == want and (best is None or seq > best[0]):
                            best = (seq, kind, v)
    except Exception:  # mid-compaction, or a format we don't know
        return None
    if not best or best[1] != 1:
        return None
    v = best[2]
    return v[1:].decode("latin-1") if v[:1] == b"\x01" else v[1:].decode("utf-16-le", "replace")


def _ancestor(names):
    """(pid, start) of the nearest process above this hook whose name starts with one
    of `names`: the agent that ran the hook. None if there isn't one."""
    try:
        out = subprocess.run(["/bin/ps", "-A", "-o", "pid=,ppid=,lstart=,comm="],
                             capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    procs = {}
    for line in out.splitlines():
        p = line.split(None, 7)
        if len(p) == 8:
            procs[int(p[0])] = (int(p[1]), " ".join(p[2:7]), os.path.basename(p[7]))
    pid, seen = os.getppid(), set()
    while pid in procs and pid not in seen and pid > 1:
        seen.add(pid)
        ppid, start, comm = procs[pid]
        if comm.startswith(names):
            return pid, start
        pid = ppid
    return None


def _app_of(pid):
    """Bundle id of the nearest app above process `pid` (the terminal, IDE or app it
    runs in), or None. Claude Code's own CLI bundle is looked past."""
    try:
        out = subprocess.run(["/bin/ps", "-A", "-o", "pid=,ppid=,comm="],
                             capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    procs = {}
    for line in out.splitlines():
        p = line.strip().split(None, 2)
        if len(p) == 3 and p[0].isdigit() and p[1].isdigit():
            procs[int(p[0])] = (int(p[1]), p[2])
    if pid not in procs:
        return None
    pid, seen = procs[pid][0], set()
    while pid in procs and pid not in seen and pid > 1:
        seen.add(pid)
        ppid, comm = procs[pid]
        if ".app/" in comm:
            app = comm.split(".app/", 1)[0] + ".app"
            try:
                import plistlib
                with open(os.path.join(app, "Contents", "Info.plist"), "rb") as f:
                    bundle = plistlib.load(f).get("CFBundleIdentifier")
            except (OSError, ValueError, ImportError):
                return None
            if bundle != CLAUDE_CLI_BUNDLE:
                return bundle
        pid = ppid
    return None


def _proc_start(pid):
    """When process `pid` started, or "" if it isn't running."""
    try:
        out = subprocess.run(["/bin/ps", "-o", "lstart=", "-p", str(int(pid))], capture_output=True,
                             text=True, timeout=2).stdout
    except (OSError, ValueError, subprocess.SubprocessError):
        return ""
    return " ".join(out.split())


def _new_record(tool, sid, cwd):
    return {"tool": tool, "session_id": sid, "state": None, "reason": "", "cwd": cwd or "",
            "title": os.path.basename((cwd or "").rstrip("/")) or tool, "updated_at": 0,
            "seen": True}


def _terminal_or(bundle):
    """Started from a terminal: bring that terminal forward. Otherwise the app."""
    term = os.environ.get("__CFBundleIdentifier")
    return {"kind": "app", "target": term or bundle}


def _t3_env():
    """True when a hook is running inside a T3 Code managed agent thread."""
    return "T3CODE_THREAD_ID" in os.environ or "T3_ACP_MCP_NODE" in os.environ


# ---------------------------------------------------------------- agents
#
# One adapter per agent. Each says how to install its hooks, how to read its hook
# events, how to get back to a session, and (optionally) what its own records say.
# To add an agent, subclass Agent and add it to AGENTS.

def _app_unread(rec, x, unread, now):
    """Takes the app's own unread mark (its sidebar dot) for a session. Marked unread
    since the last pass, by the app or by you ("Mark as unread"): unread. Not marked:
    read, after a moment's grace (the app sets the mark just after the turn ends)."""
    x["unread"] = unread
    if unread and not rec.get("app_unread"):
        x["marked"] = True
    if not unread and now - rec.get("updated_at", 0) > 5:
        x["read"] = True
    rec["app_unread"] = unread


class Agent:
    name = ""      # short id, used in record keys and hook commands
    label = ""     # shown in the panel
    bundle = ""    # the app's bundle id: its icon, and the app to bring forward

    def translate(self, event, data):
        """A hook event as a dict: kind (see the state machine), sid, and optionally
        reason, detail, cwd, transcript, prompt. None to ignore it."""
        raise NotImplementedError

    def jump(self, sid, data):
        return _terminal_or(self.bundle)

    def turn(self, path):
        """(state, reason, time) of the last turn in a transcript, or None."""
        return None

    def scan(self, recs, now, facts):
        """Add or correct records from the agent's own records. `facts[key]` takes
        "focused" (when you last opened it), "read" (the app says it's read) and
        "unread" (the app's own unread mark, for finishes the hooks didn't see)."""

    def process(self):
        """Called in a hook: fields to keep on the record that identify the process
        running the session, so alive() can tell when it's gone. None if unknown."""
        return None

    def alive(self, rec):
        """False when a terminal session's process is gone; None if we can't tell."""
        return None

    def on_screen(self, rec):
        """True if a turn that just finished was already on screen, so it's seen."""
        return False

    def hook_output(self, event):
        """What the hook prints on stdout. Most agents want nothing."""
        return None

    def present(self):
        """Whether this agent is on this Mac; install skips it if not."""
        return True

    def install(self):
        pass

    def uninstall(self):
        pass


def _claude_style_event(event, data, ask_tools=()):
    """Translation shared by Claude Code and Codex, whose hook payloads match."""
    tool = data.get("tool_name", "")
    ev = {"sid": data.get("session_id") or data.get("thread_id") or "",
          "cwd": data.get("cwd"), "transcript": data.get("transcript_path")}
    if event == "UserPromptSubmit":
        ev.update(kind="prompt", prompt=_first_line(data.get("prompt")))
    elif event == "SessionStart":
        ev.update(kind="start")
    elif event in ("PreToolUse", "PermissionRequest") and tool in ask_tools:
        # Claude Desktop sends PermissionRequest for its question tools too.
        ev.update(kind="wait", reason="plan" if tool == "ExitPlanMode" else "question")
    elif event == "PermissionRequest":
        ev.update(kind="wait", reason="permission", detail=tool)
    elif event == "Notification":
        if data.get("notification_type") not in WAIT_NOTIFICATIONS:
            return None
        ev.update(kind="wait_hint")
    elif event in ("PostToolUse", "PostToolUseFailure"):
        ev.update(kind="tool_done")
    elif event == "Stop":
        ev.update(kind="turn_done")
    elif event == "Interrupt":
        ev.update(kind="interrupt")
    elif event == "SessionEnd":
        ev.update(kind="end")
    else:
        return None
    return ev


def _edit_json(path, fn):
    data = {}
    if os.path.exists(path):
        with open(path) as f:
            text = f.read()
        data = json.loads(text) if text.strip() else {}
        backup = "%s.bak-agent-status-%s" % (path, time.strftime("%Y%m%d-%H%M%S"))
        with open(backup, "w") as f:
            f.write(text)
        print("  backup: " + backup)
    fn(data)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, path)
    print("  wrote:  " + path)


def _strip_ours(hooks):
    """Remove our entries from a Claude-style hooks mapping, leaving the rest alone."""
    for event in list(hooks):
        groups = []
        for g in hooks[event]:
            inner = [h for h in g.get("hooks", []) if HOOK_MARKER not in h.get("command", "")]
            if inner:
                g = dict(g, hooks=inner)
                groups.append(g)
            elif not g.get("hooks"):
                groups.append(g)
        if groups:
            hooks[event] = groups
        else:
            del hooks[event]


def _hook_cmd(tool, event=""):
    return ('"%s" hook %s %s' % (SELF, tool, event)).rstrip()


def _install_claude_style(path, tool, events):
    def fn(data):
        hooks = data.setdefault("hooks", {})
        _strip_ours(hooks)
        for event, matcher in events:
            group = {"hooks": [{"type": "command", "command": _hook_cmd(tool), "timeout": 3}]}
            if matcher:
                group = dict({"matcher": matcher}, **group)
            hooks.setdefault(event, []).append(group)
    _edit_json(path, fn)


def _uninstall_claude_style(path, quiet=False):
    if not os.path.exists(path):
        return
    if quiet:
        try:
            with open(path) as f:
                if json.dumps(HOOK_MARKER)[1:-1] not in f.read():  # as it's escaped in JSON
                    return
        except OSError:
            return

    def fn(data):
        _strip_ours(data.get("hooks", {}))
        if data.get("hooks") == {}:
            del data["hooks"]
    _edit_json(path, fn)


class Claude(Agent):
    name, label, bundle = "claude", "Claude", CLAUDE_BUNDLE
    SETTINGS = "~/.claude/settings.json"
    PROJECTS = "~/.claude/projects"
    REGISTRY = "~/.claude/sessions"
    DESKTOP_SESSIONS = "~/Library/Application Support/Claude/claude-code-sessions"
    DESKTOP_STORAGE = "~/Library/Application Support/Claude/Local Storage/leveldb"
    _live = {}
    _apps = {}  # pid -> the app it runs in (cached: a process doesn't move)

    def translate(self, event, data):
        if _t3_env():
            return None
        return _claude_style_event(event, data, ASK_TOOLS)

    def jump(self, sid, data):
        host = os.environ.get("CLAUDE_CODE_HOST_SESSION_ID", "")
        # Child processes inherit the host id, so also require that this CLI is the
        # one Desktop started, not a `claude` run inside a Desktop session.
        if host.startswith("local_") and os.environ.get("CLAUDE_CODE_ENTRYPOINT") == "claude-desktop":
            return {"kind": "url", "target": "claude://claude.ai/epitaxy/" + host, "fallback": self.bundle}
        return _terminal_or(self.bundle)

    def turn(self, path):
        for raw in _tail(path):
            if not raw.strip():
                continue
            try:
                d = json.loads(raw)
            except ValueError:
                continue
            kind, ts = d.get("type"), _iso(d.get("timestamp"))
            if kind == "system":
                if d.get("subtype") in ("stop_hook_summary", "turn_duration"):
                    return ("done", "", ts)
            elif kind == "assistant":
                if (d.get("message") or {}).get("stop_reason") in ("end_turn", "stop_sequence"):
                    return ("done", "", ts)
                return ("running", "", ts)
            elif kind == "user" and not d.get("isMeta"):
                if b"[Request interrupted by user" in raw:  # Esc, or a denied approval
                    return ("idle", "interrupted", ts)
                if b"<local-command-stdout>" in raw:  # a slash command that ran no turn
                    continue
                return ("running", "", ts)
        return None

    def desktop_sessions(self, since, marked=()):
        """Claude Desktop's own session files, by CLI session id: the ones active since
        `since`, and any Desktop marks unread however old."""
        out = {}
        pattern = os.path.join(os.path.expanduser(self.DESKTOP_SESSIONS), "*", "*", "local_*.json")
        for f in glob.glob(pattern):
            try:
                if os.path.getmtime(f) < since and os.path.basename(f)[:-5] not in marked:
                    continue
                with open(f) as fh:
                    d = json.load(fh)
            except (OSError, ValueError):
                continue
            if d.get("cliSessionId"):
                out[d["cliSessionId"]] = d
        return out

    def desktop_unread(self):
        """Claude Desktop's own unread marks (its sidebar dots), by Desktop session id.
        None if they can't be read."""
        raw = _local_storage(os.path.expanduser(self.DESKTOP_STORAGE), "epitaxy-unread-v1")
        try:
            state = json.loads(raw)["state"]
            return set(state.get("unreadIds") or []) | set(state.get("explicitUnreadIds") or [])
        except (TypeError, ValueError, KeyError, AttributeError):
            return None

    def live_sessions(self):
        """Claude Code's own registry of running sessions, by session id. Each process
        keeps a file there while it runs, and rewrites it as its state changes:
        `status` is busy / waiting / idle (or shell), and `waitingFor`, while waiting,
        is "permission prompt", "input needed" (a question) or another dialog."""
        out = {}
        for f in glob.glob(os.path.join(os.path.expanduser(self.REGISTRY), "*.json")):
            try:
                with open(f) as fh:
                    d = json.load(fh)
                os.kill(int(d["pid"]), 0)
            except PermissionError:
                pass  # running, as another user
            except (OSError, ValueError, KeyError, TypeError):
                continue
            d["pid"] = int(d["pid"])
            out[d.get("sessionId")] = d
        return out

    def alive(self, rec):
        # Desktop sessions outlive their process: the app resumes them.
        if (rec.get("jump") or {}).get("kind") == "url":
            return None
        live = self._live.get(rec.get("session_id"))
        if live:
            rec["pid"] = live["pid"]
            return True
        # Gone from the registry. Only trusted once we've seen it there.
        return False if rec.get("pid") else None

    @staticmethod
    def pending_tool(path):
        """The tool the last assistant message is waiting on, from the transcript."""
        for raw in _tail(path, 64 * 1024):
            if b'"assistant"' not in raw:
                continue
            try:
                d = json.loads(raw)
            except ValueError:
                continue
            if d.get("type") != "assistant":
                continue
            content = (d.get("message") or {}).get("content") or []
            names = [c.get("name") for c in content if isinstance(c, dict) and c.get("type") == "tool_use"]
            return names[-1] if names else None
        return None

    def registry_state(self, d, transcript=""):
        """(state, reason) from a registry record; None once the turn is over (idle:
        the transcript says whether it finished or was stopped)."""
        status = d.get("status")
        if status == "busy":
            return ("running", "")
        if status == "waiting":
            tool = self.pending_tool(transcript) if transcript else None
            if tool == "ExitPlanMode":
                return ("waiting", "plan")
            if tool in ASK_TOOLS or d.get("waitingFor") == "input needed":
                return ("waiting", "question")
            return ("waiting", "permission")
        return None

    def scan(self, recs, now, facts):
        self._live = self.live_sessions()
        for sid, d in self._live.items():
            if not sid or d.get("spare") or d.get("kind") not in (None, "interactive") or not d.get("status"):
                continue
            key = "claude-" + _safe(sid)
            desktop = d.get("entrypoint") == "claude-desktop"
            if not desktop and d["pid"] not in self._apps:
                self._apps[d["pid"]] = _app_of(d["pid"])
            app = None if desktop else self._apps.get(d["pid"])
            if app == T3_BUNDLE:
                continue  # a T3 Code thread; its own adapter shows it
            if key not in recs:
                if d.get("status") == "idle" and (d.get("statusUpdatedAt") or 0) / 1000 < now - RECENT:
                    continue
                rec = recs[key] = _new_record("claude", sid, d.get("cwd"))
                found = glob.glob(os.path.join(os.path.expanduser(self.PROJECTS), "*", sid + ".jsonl"))
                if found:
                    rec["transcript"] = found[0]
            rec = recs[key]
            host = d.get("hostSessionId") or ""
            if desktop and host.startswith("local_"):
                rec["jump"] = {"kind": "url", "target": "claude://claude.ai/epitaxy/" + host,
                               "fallback": self.bundle}
            elif not desktop:
                rec["jump"] = {"kind": "app", "target": app or self.bundle}
            if d.get("name") and not rec.get("name"):
                rec["name"] = d["name"]
            facts.setdefault(key, {})["live"] = (self.registry_state(d, rec.get("transcript")),
                                                 (d.get("statusUpdatedAt") or 0) / 1000)
        unread = self.desktop_unread()
        for sid, d in self.desktop_sessions(now - RECENT, unread or ()).items():
            key = "claude-" + _safe(sid)
            active = (d.get("lastActivityAt") or 0) / 1000
            if key not in recs:
                if d.get("isArchived") or (active < now - RECENT and d["sessionId"] not in (unread or ())):
                    continue
                rec = recs[key] = _new_record("claude", sid, d.get("cwd"))
                found = glob.glob(os.path.join(os.path.expanduser(self.PROJECTS), "*", sid + ".jsonl"))
                if found:
                    rec["transcript"] = found[0]
            rec = recs[key]
            rec["jump"] = {"kind": "url", "target": "claude://claude.ai/epitaxy/" + d["sessionId"],
                           "fallback": self.bundle}
            if d.get("title"):
                rec["name"] = d["title"]
            if d.get("isArchived"):
                rec["hidden"] = True
            facts.setdefault(key, {})["focused"] = (d.get("lastFocusedAt") or 0) / 1000
            if unread is not None:
                _app_unread(rec, facts[key], d["sessionId"] in unread, now)

    def on_screen(self, rec):
        """The Desktop session you were looking at when it finished."""
        host = ((rec.get("jump") or {}).get("target") or "").rsplit("/", 1)[-1]
        if not host.startswith("local_") or _frontmost() != self.bundle:
            return False
        sessions = self.desktop_sessions(time.time() - RECENT).values()
        focus = {d.get("sessionId"): d.get("lastFocusedAt") or 0 for d in sessions}
        return bool(focus) and focus.get(host, -1) >= max(focus.values())

    def install(self):
        # No hooks: Claude Code's own session registry says everything. Clear out the
        # ones older versions added.
        _uninstall_claude_style(os.path.expanduser(self.SETTINGS), quiet=True)
        print("  no hooks needed; reads Claude Code's own session state.")

    def uninstall(self):
        _uninstall_claude_style(os.path.expanduser(self.SETTINGS))


class Codex(Agent):
    name, label, bundle = "codex", "Codex", CODEX_BUNDLE
    HOOKS = "~/.codex/hooks.json"
    EVENTS = [
        ("SessionStart", None), ("UserPromptSubmit", None), ("PermissionRequest", None),
        ("PostToolUse", None), ("Stop", None), ("Interrupt", None), ("SessionEnd", None),
    ]

    def translate(self, event, data):
        if _t3_env() or not data.get("transcript_path"):
            # The Codex app runs short internal sessions of its own (summaries, safety
            # review) that fire hooks too. They have no transcript and no thread you
            # could open, so they aren't yours to track. T3 Code tracks its own threads.
            return None
        return _claude_style_event(event, data)

    @staticmethod
    def in_app():
        # Seen in practice: "Codex Desktop".
        return os.environ.get("CODEX_INTERNAL_ORIGINATOR_OVERRIDE", "").lower().endswith("desktop")

    def jump(self, sid, data):
        if self.in_app():
            return {"kind": "url", "target": "codex://threads/" + sid, "fallback": self.bundle}
        return _terminal_or(self.bundle)

    def process(self):
        # A terminal session lives as long as the codex process that runs its hooks.
        found = None if self.in_app() else _ancestor(("codex",))
        return {"pid": found[0], "pid_start": found[1]} if found else {"pid": 0}

    def alive(self, rec):
        if (rec.get("jump") or {}).get("kind") == "url" or not rec.get("pid"):
            return None
        return _proc_start(rec["pid"]) == rec.get("pid_start")

    def turn(self, path):
        for raw in _tail(path):
            if b'"event_msg"' not in raw:
                continue
            try:
                d = json.loads(raw)
            except ValueError:
                continue
            kind, ts = (d.get("payload") or {}).get("type"), _iso(d.get("timestamp"))
            if kind == "task_complete":
                return ("done", "", ts)
            if kind == "turn_aborted":
                return ("idle", "interrupted", ts)
            if kind in ("task_started", "turn_started"):
                return ("running", "", ts)
        return None

    @staticmethod
    def thread_source(path):
        """Who started a thread, from its rollout's first line: "user" for one you
        started, something else for a subagent; "" if the file isn't there yet."""
        try:
            with open(path, "rb") as f:
                meta = json.loads(f.readline())
        except (OSError, ValueError):
            return ""
        p = meta.get("payload") or {}
        if isinstance(p.get("source"), dict) and "subagent" in p["source"]:
            return "subagent"
        return p.get("thread_source") or ""

    @staticmethod
    def app_unread():
        """The Codex app's own unread marks (its sidebar dots, "Mark as unread"
        included), as thread ids. None if they can't be read."""
        rows = _sqlite_rows(
            os.path.join(CODEX_HOME, ".codex-global-state.sqlite"),
            "SELECT value FROM settings WHERE key = 'electron-thread-read-state-v1'", (), default=None)
        if not rows:
            return None
        try:
            out = set()
            for hosts in json.loads(rows[0][0])["unreadByIdentity"].values():
                for host, ids in hosts.items():
                    if host.split(":")[0] == "local":  # threads on this Mac
                        out.update(ids)
            return out
        except (TypeError, ValueError, KeyError, AttributeError):
            return None

    def scan(self, recs, now, facts):
        marked = self.app_unread()
        known = [r["session_id"] for r in recs.values() if r.get("tool") == "codex" and r.get("session_id")]
        ids = known + sorted(marked or ())
        rows = _sqlite_rows(
            os.path.join(CODEX_HOME, "state_*.sqlite"),
            "SELECT t.id, t.rollout_path, t.cwd, COALESCE(NULLIF(t.name, ''), t.title),"
            " t.archived, t.originator, t.thread_source, r.first_unread_turn"
            " FROM threads t LEFT JOIN thread_read_receipts r ON r.thread_id = t.id"
            " WHERE t.updated_at_ms >= ? OR t.id IN (%s)" % ",".join("?" * len(ids)),
            [int((now - RECENT) * 1000)] + ids, default=None)
        threads = set()
        for tid, rollout, cwd, title, archived, originator, source, receipt in rows or ():
            threads.add(tid)
            key = "codex-" + _safe(tid)
            if key not in recs:
                if archived or source != "user" or originator != "Codex Desktop":
                    continue
                recs[key] = _new_record("codex", tid, cwd)
            rec = recs[key]
            if rollout:
                rec.setdefault("transcript", rollout)
            if title:
                rec["name"] = title.strip().splitlines()[0]
            if archived:
                rec["hidden"] = True
            if originator == "Codex Desktop":
                rec["jump"] = {"kind": "url", "target": "codex://threads/" + tid, "fallback": self.bundle}
                # The sidebar's own marks when we can read them, else the read receipt.
                unread = tid in marked if marked is not None else bool(receipt)
                _app_unread(rec, facts.setdefault(key, {}), unread, now)

        for key in [k for k, r in recs.items() if r.get("tool") == "codex"]:
            rec = recs[key]
            if not rec.get("transcript"):
                # Left by an internal Codex app session (see translate): drop it.
                remove(key)
                del recs[key]
                continue
            if (rows is not None and rec.get("session_id") not in threads
                    and (rec.get("jump") or {}).get("target", "").startswith("codex://")
                    and (not os.path.exists(rec["transcript"]) or now - rec.get("since", now) > 60)):
                # The app no longer has this thread (deleted, or one it never listed:
                # it opens as "Chat unavailable on this computer"). Nothing to show.
                remove(key)
                del recs[key]
                continue
            if not rec.get("thread_source"):  # retried until the rollout file exists
                rec["thread_source"] = self.thread_source(rec["transcript"])
            if rec["thread_source"] not in ("user", ""):
                rec["hidden"] = True  # a subagent's thread, not one you started

    def install(self):
        _install_claude_style(os.path.expanduser(self.HOOKS), self.name, self.EVENTS)
        print("\nCodex trust:")
        if sys.stdin.isatty() and _codex_exe():
            cmd_trust_codex()
        else:
            print("  Codex runs new hooks only after you trust them. Run:\n"
                  "    %s trust-codex\n"
                  "  or open Codex → Settings → Hooks → Review hooks." % _q(SELF))

    def uninstall(self):
        _uninstall_claude_style(os.path.expanduser(self.HOOKS))


class Antigravity(Agent):
    """Google Antigravity. Its hooks differ from Claude's: no prompt event (a model
    invocation means it's working), camelCase payloads with no event name (we pass
    it on the command line), and some events read a decision from stdout."""
    name, label, bundle = "antigravity", "Antigravity", "com.google.antigravity"
    HOOKS = "~/.gemini/config/hooks.json"
    HOOK_NAME = "agent-status"
    APP_DIRS = ("~/.gemini/antigravity", "~/.gemini/antigravity-ide", "~/.gemini/antigravity-cli")
    # The tools Antigravity uses to ask you something.
    ASK = {"ask_question": "question", "ask_permission": "permission"}
    # The documented "carry on as normal" answers for events that read stdout.
    NEUTRAL = {"PreToolUse": {"decision": "allow"}, "Stop": {"decision": "allow"}}

    def translate(self, event, data):
        sid = data.get("conversationId") or os.environ.get("ANTIGRAVITY_CONVERSATION_ID") or ""
        roots = data.get("workspacePaths") or []
        path = data.get("transcriptPath") or ""
        if _t3_env() or "/antigravity-acp/" in path or "/.t3/userdata/providers/" in path:
            return None
        ev = {"sid": sid, "cwd": data.get("cwd") or (roots[0] if roots else ""),
              "transcript": os.path.expanduser(path) if path else ""}
        tool = (data.get("toolCall") or {}).get("name", "")
        if event == "SessionStart":
            ev.update(kind="start")
        elif event == "PreInvocation":
            ev.update(kind="working")
            if data.get("invocationNum") == 0:
                ev["prompt"] = _first_line(data.get("lastUserInput"))
        elif event == "PreToolUse" and tool in self.ASK:
            ev.update(kind="wait", reason=self.ASK[tool])
        elif event == "PostToolUse":
            ev.update(kind="tool_done")
        elif event == "Stop":
            ev.update(kind="turn_done")
        else:
            return None
        return ev

    def jump(self, sid, data):
        # No documented link to a single conversation: bring the app (Antigravity or
        # Antigravity IDE) or, for the CLI, its terminal forward.
        path = data.get("transcriptPath") or ""
        if "antigravity-cli" in path:
            return _terminal_or(self.bundle)
        app = os.environ.get("__CFBundleIdentifier")
        return {"kind": "app", "target": app if app in ANTIGRAVITY_BUNDLES else self.bundle}

    def process(self):
        app = os.environ.get("__CFBundleIdentifier")
        return {"bundle": app} if app in ANTIGRAVITY_BUNDLES else None

    @staticmethod
    def app_dir(rec):
        """The product's data folder (~/.gemini/antigravity, -ide or -cli), from the
        transcript path: <dir>/brain/<conversation>/.system_generated/logs/..."""
        path = rec.get("transcript") or ""
        return path.split("/brain/")[0] if "/brain/" in path else ""

    @staticmethod
    def viewed(app_dir, cid):
        """When you last looked at a conversation, from Antigravity's annotations."""
        try:
            with open(os.path.join(app_dir, "annotations", cid + ".pbtxt")) as f:
                text = f.read()
        except OSError:
            return 0
        import re
        m = re.search(r"last_user_view_time:\s*\{\s*seconds:\s*(\d+)", text)
        return int(m.group(1)) if m else 0

    def turn(self, path):
        """Each line of the transcript is one step. A step waiting on you has status
        WAITING; a turn is over when the last step is a reply with no tool calls."""
        for raw in _tail(path):
            if not raw.strip():
                continue
            try:
                d = json.loads(raw)
            except ValueError:
                continue
            kind, status, ts = d.get("type"), d.get("status"), _iso(d.get("created_at"))
            if status == "WAITING":
                return ("waiting", "permission", ts)
            if kind == "USER_INPUT":
                return ("running", "", ts)
            if kind == "PLANNER_RESPONSE" and status == "DONE" and not d.get("tool_calls"):
                return ("done", "", ts)
            if kind == "ERROR_MESSAGE":
                return ("done", "", ts)
            if status in ("CANCELED", "INTERRUPTED", "HALTED"):
                return ("idle", "interrupted", ts)
            return ("running", "", ts)
        return None

    def scan(self, recs, now, facts):
        """Titles, which conversations are subagents', and when you last looked at
        each, from Antigravity's own records."""
        mine = {r["session_id"]: k for k, r in recs.items()
                if r.get("tool") == self.name and r.get("session_id")}
        if not mine:
            return
        for cid, key in mine.items():
            d = self.app_dir(recs[key])
            if d:
                facts[key] = {"focused": self.viewed(d, cid)}
        for d in self.APP_DIRS:
            rows = _sqlite_rows(
                os.path.join(d, "conversation_summaries.db"),
                "SELECT conversation_id, title, nesting_depth FROM conversation_summaries"
                " WHERE conversation_id IN (%s)" % ",".join("?" * len(mine)), list(mine))
            for cid, title, depth in rows:
                rec = recs[mine[cid]]
                if title:
                    rec["name"] = title
                if depth:
                    rec["hidden"] = True  # a subagent's conversation, not one you started

    def on_screen(self, rec):
        """The conversation you were looking at in Antigravity when it finished."""
        d = self.app_dir(rec)
        bundle = rec.get("bundle") or (rec.get("jump") or {}).get("target") or self.bundle
        if not d or _frontmost() != bundle:
            return False
        views = {os.path.basename(f)[:-len(".pbtxt")]: 0
                 for f in glob.glob(os.path.join(d, "annotations", "*.pbtxt"))}
        views = {cid: self.viewed(d, cid) for cid in views}
        return bool(views) and views.get(rec.get("session_id"), -1) >= max(views.values())

    def hook_output(self, event):
        return self.NEUTRAL.get(event, {})

    def present(self):
        return os.path.isdir(os.path.expanduser("~/.gemini")) or os.path.isdir("/Applications/Antigravity.app")

    def install(self):
        path = os.path.expanduser(self.HOOKS)

        def handler(event):
            return {"type": "command", "command": _hook_cmd(self.name, event), "timeout": 5}

        def fn(data):
            # Our own named entry; other hooks in the file are left alone.
            data[self.HOOK_NAME] = {
                "SessionStart": [handler("SessionStart")],
                "PreInvocation": [handler("PreInvocation")],
                "Stop": [handler("Stop")],
                "PostToolUse": [{"matcher": "", "hooks": [handler("PostToolUse")]}],
                # Only the tools that ask you something: our answer is "allow", and we
                # don't want to be anywhere near the approval of anything else.
                "PreToolUse": [{"matcher": "|".join(sorted(self.ASK)), "hooks": [handler("PreToolUse")]}],
            }
        _edit_json(path, fn)

    def uninstall(self):
        path = os.path.expanduser(self.HOOKS)
        if os.path.exists(path):
            _edit_json(path, lambda data: data.pop(self.HOOK_NAME, None))


class T3Code(Agent):
    """T3 Code desktop app. Reads its SQLite projection directly so every provider
    (Antigravity ACP, Codex, Claude) is tracked without duplicate rows and jumps
    straight to the thread via t3code://threads/<env>/<thread>."""
    name, label, bundle = "t3code", "T3 Code", T3_BUNDLE

    def translate(self, event, data):
        return None

    def present(self):
        return (os.path.isdir(os.path.expanduser(T3_USERDATA))
                or os.path.isdir("/Applications/T3 Code (Beta).app"))

    @staticmethod
    def _env_id():
        try:
            with open(os.path.join(os.path.expanduser(T3_USERDATA), "environment-id")) as f:
                return f.read().strip()
        except OSError:
            return ""

    def scan(self, recs, now, facts):
        db = os.path.join(os.path.expanduser(T3_USERDATA), "statev2.sqlite")
        if not os.path.exists(db):
            return
        threads = _sqlite_rows(
            db,
            "SELECT thread_id, project_id, title, updated_at, archived_at, payload_json"
            " FROM orchestration_v2_projection_threads WHERE deleted_at IS NULL",
            (),
        )
        if not threads:
            for k, r in recs.items():
                if r.get("tool") == self.name:
                    r["hidden"] = True
            return

        env_id = self._env_id()
        projects = dict(_sqlite_rows(db, "SELECT project_id, workspace_root FROM projection_projects", ()))
        runs = {}
        for tid, status, req_at, comp_at in _sqlite_rows(
            db,
            "SELECT r.thread_id, r.status, r.requested_at, r.completed_at"
            " FROM orchestration_v2_projection_runs r"
            " JOIN (SELECT thread_id, MAX(ordinal) AS max_ord FROM orchestration_v2_projection_runs GROUP BY thread_id) m"
            " ON r.thread_id = m.thread_id AND r.ordinal = m.max_ord",
            (),
        ):
            runs[tid] = (status, req_at, comp_at)

        pending = {}
        for tid, kind, created_at in _sqlite_rows(
            db,
            "SELECT thread_id, kind, created_at FROM orchestration_v2_projection_runtime_requests"
            " WHERE status IN ('pending', 'waiting') AND resolved_at IS NULL"
            " ORDER BY (kind = 'user_input') DESC, created_at DESC",
            (),
        ):
            pending.setdefault(tid, (kind, created_at))

        prompts = {}
        for tid, pj in _sqlite_rows(
            db,
            "SELECT thread_id, payload_json FROM orchestration_v2_projection_messages"
            " WHERE role = 'user' ORDER BY created_at DESC LIMIT 200",
            (),
        ):
            if tid in prompts:
                continue
            try:
                prompts[tid] = _first_line(json.loads(pj).get("text"))
            except ValueError:
                pass

        parsed = []
        max_visited_tid, max_visited_ts = None, 0
        seen_tids = set()
        for tid, pid, title, updated_at, archived_at, pj in threads:
            seen_tids.add(tid)
            try:
                payload = json.loads(pj) if pj else {}
            except ValueError:
                payload = {}
            lv = _iso(payload.get("lastVisitedAt") or "")
            if not archived_at and lv > max_visited_ts:
                max_visited_tid, max_visited_ts = tid, lv
            parsed.append((tid, pid, title, updated_at, archived_at, payload, lv))

        front_t3 = _frontmost() == self.bundle

        for k, r in recs.items():
            if r.get("tool") == self.name and r.get("session_id") not in seen_tids:
                r["hidden"] = True

        for tid, pid, title, updated_at, archived_at, payload, last_visited in parsed:
            key = "t3code-" + _safe(tid)
            if archived_at or (payload.get("lineage") or {}).get("relationshipToParent") == "subagent":
                if key in recs:
                    recs[key]["hidden"] = True
                continue

            updated_ts = _iso(updated_at)
            if tid in pending:
                req_kind, req_ts = pending[tid]
                state = "waiting"
                reason = ("question" if req_kind == "user_input"
                          else "plan" if "plan" in (req_kind or "").lower()
                          else "permission")
                ts = _iso(req_ts) or updated_ts
            elif tid in runs:
                run_status, req_at, comp_at = runs[tid]
                if run_status in ("preparing", "queued", "starting", "running", "waiting"):
                    state, reason, ts = "running", "", _iso(req_at) or updated_ts
                elif run_status in ("completed", "failed"):
                    state, reason, ts = "done", "", _iso(comp_at or req_at) or updated_ts
                elif run_status in ("cancelled", "interrupted"):
                    state, reason, ts = "idle", "interrupted", _iso(comp_at or req_at) or updated_ts
                else:
                    state, reason, ts = "idle", "", updated_ts
            else:
                continue

            if key not in recs and state not in ("running", "waiting") and ts < now - RECENT:
                continue

            cwd = payload.get("worktreePath") or projects.get(pid) or ""
            rec = recs.get(key)
            if rec is None:
                rec = recs[key] = _new_record(self.name, tid, cwd)
            rec.pop("hidden", None)
            rec["cwd"] = cwd
            rec["title"] = os.path.basename(cwd.rstrip("/")) or self.label
            if title:
                rec["name"] = title.strip().splitlines()[0]
            if prompts.get(tid):
                rec["prompt"] = prompts[tid]
            rec["jump"] = (
                {"kind": "url", "target": "t3code://threads/%s/%s" % (env_id, tid), "fallback": self.bundle}
                if env_id else {"kind": "app", "target": self.bundle}
            )

            settled_at = _iso(payload.get("settledAt") or "")
            is_read = (payload.get("settledOverride") == "settled"
                       or max(settled_at, last_visited) >= ts)
            if state != rec.get("state"):
                on_screen_now = front_t3 and max_visited_tid == tid
                rec["seen"] = state != "done" or is_read or on_screen_now
                rec["state"], rec["reason"] = state, reason
                rec["since"] = rec["updated_at"] = ts
                rec.pop("detail", None)
                if rec["seen"] and state == "done":
                    rec["seen_at"] = int(now)
                else:
                    rec.pop("seen_at", None)
            else:
                rec["updated_at"] = max(rec.get("updated_at", 0), ts)

            if rec.get("state") == "done" and not rec.get("seen") and is_read:
                facts[key] = {"read": True}


AGENTS = {a.name: a for a in (Claude(), Codex(), Antigravity(), T3Code())}


# ---------------------------------------------------------------- collect

def collect():
    """All sessions worth showing, with hook state corrected by what the agents
    record themselves. Writes back what changed. Call with the lock held."""
    now = time.time()
    recs = {r.pop("_key"): r for r in all_records()}
    before = {k: json.dumps(r, sort_keys=True) for k, r in recs.items()}
    facts = {}  # per-session facts for this pass only
    for agent in AGENTS.values():
        agent.scan(recs, now, facts)

    for key, rec in recs.items():
        agent = AGENTS.get(rec.get("tool"))
        x = facts.get(key, {})
        path = rec.get("transcript")
        mtime = os.path.getmtime(path) if path and os.path.exists(path) else 0
        turn = agent.turn(path) if agent and mtime else None
        # The transcript wins only when it's newer than the last hook event; the
        # hook stays the authority on approvals and questions (never downgrade
        # waiting -> running from a transcript line). For Antigravity, tool
        # approvals don't fire PreToolUse, so accept a transcript WAITING state
        # from the current turn even within the 2s hook grace window.
        allow_turn = False
        if turn:
            t_state, _, t_ts = turn
            updated = rec.get("updated_at", 0)
            if rec.get("state") is None:
                allow_turn = True
            elif rec.get("state") == "waiting" and t_state == "running":
                allow_turn = False
            elif rec.get("tool") == "antigravity" and rec.get("state") == "running" and t_state == "waiting" and t_ts >= updated - 2:
                allow_turn = True
            elif t_ts > updated + 2:
                allow_turn = True
        if allow_turn:
            state, reason, ts = turn
            if state != rec.get("state"):
                # A finish is news only if we saw that turn running. One we learn about
                # later (an old chat reopened, or found in the app's list) is unread
                # only if the app itself marks it unread.
                watched = rec.get("state") in ("running", "waiting")
                rec["seen"] = state != "done" or not (watched or x.get("unread"))
                rec["state"], rec["reason"] = state, reason
                rec.pop("detail", None)
                rec.pop("seen_at", None)
                # The time it really happened, not when a later hook (say, Desktop
                # resuming an old session) first told us about the session.
                rec["updated_at"] = rec["since"] = ts
            else:
                rec["updated_at"] = max(rec.get("updated_at", 0), ts)
        # The agent's own live state (Claude Code's session registry) wins over both
        # hooks and transcript while it's newer than what we have.
        if "live" in x:
            live, l_ts = x["live"]
            fresh = l_ts >= rec.get("updated_at", 0) - 2
            if live and fresh and live[0] != rec.get("state"):
                rec["state"], rec["reason"], rec["seen"] = live[0], live[1], True
                rec.pop("detail", None)
                rec.pop("seen_at", None)
                rec["updated_at"] = rec["since"] = int(l_ts)
            elif (live and fresh and live[0] == "waiting" and live[1] != rec.get("reason")
                  and rec.get("reason") != "plan"):  # a plan review shows as a permission prompt
                rec["reason"] = live[1]
                rec.pop("detail", None)
            elif not live and fresh and rec.get("state") in ("running", "waiting", None):
                # The turn is over: finished, or stopped (the transcript says which).
                was = rec.get("state")
                state, reason = (turn[0], turn[1]) if turn and turn[0] in ("done", "idle") else ("idle", "")
                rec["state"], rec["reason"] = state, reason
                rec["seen"] = state != "done" or not (was or x.get("unread"))
                rec.pop("detail", None)
                rec.pop("seen_at", None)
                rec["updated_at"] = rec["since"] = int(max(l_ts, turn[2] if turn else 0))
        if rec.get("state") is None:
            rec["state"] = "idle"
            rec["updated_at"] = rec["since"] = int(mtime or now)
        rec.setdefault("since", rec.get("updated_at", 0))  # records from before "since"
        # The app has just marked it unread (a finish, or "Mark as unread" by hand).
        # Edge-triggered, so "Mark read" here sticks until the app marks it again.
        if x.get("marked") and rec["state"] in ("done", "idle") and (rec["state"] == "idle" or rec.get("seen")):
            rec["state"], rec["reason"], rec["seen"] = "done", "", False
            rec.pop("seen_at", None)
        # A terminal session whose process is gone has ended, even without the
        # end-of-session hook (say, the terminal window was closed).
        if agent and not rec.get("hidden") and color_of(rec) != "read" and agent.alive(rec) is False:
            rec["hidden"] = True
        # You looked at it in the app after it finished.
        if rec["state"] == "done" and not rec.get("seen"):
            if x.get("focused", 0) >= rec.get("updated_at", 0) or x.get("read"):
                rec["seen"], rec["seen_at"] = True, int(now)

    shown = []
    for key, rec in recs.items():
        # Housekeeping only: a record that isn't shown (seen, interrupted, closed)
        # goes once its session is older than the scan window, so it can't come back.
        # Shown sessions stay until their real state changes, however long that takes.
        if rec.get("hidden") or color_of(rec) == "read":
            if now - max(rec.get("updated_at", 0), rec.get("seen_at", 0)) > RECENT:
                remove(key)
                continue
        if json.dumps(rec, sort_keys=True) != before.get(key):
            save(key, rec)
        if not rec.get("hidden"):
            rec["_key"] = key
            shown.append(rec)
    return shown


def _q(s):
    return '"%s"' % str(s).replace('"', "'")


# ---------------------------------------------------------------- actions

def _activate(bundle):
    """Bring an app to the front. `open -b` alone may leave it behind the current app."""
    script = 'tell application id "%s" to activate' % bundle
    if subprocess.call(["/usr/bin/osascript", "-e", script],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
        return True
    return subprocess.call(["/usr/bin/open", "-b", bundle]) == 0


def cmd_open(key):
    with Lock():
        rec = load(key)
        if not rec:
            return
        if rec.get("state") == "done" and not rec.get("seen"):
            rec["seen"], rec["seen_at"] = True, int(time.time())
            save(key, rec)
    jump = rec.get("jump") or {}
    agent = AGENTS.get(rec.get("tool"))
    default = agent.bundle if agent else CLAUDE_BUNDLE
    debug_log("open", {"key": key, "state": rec.get("state"), "jump": jump})
    if jump.get("kind") == "url":
        # The deep link switches the app to the session; then bring the app forward.
        subprocess.call(["/usr/bin/open", jump["target"]])
        _activate(jump.get("fallback") or default)
    elif jump.get("kind") == "app":
        if not _activate(jump["target"]):
            _activate(default)
    else:
        _activate(default)


def cmd_seen_all():
    with Lock():
        for r in all_records():
            if r.get("state") == "done" and not r.get("seen"):
                r["seen"], r["seen_at"] = True, int(time.time())
                save(r.pop("_key"), r)


def cmd_status():
    """The sessions to show and how many of each kind. The menu bar app reads this."""
    with Lock():
        records = [r for r in collect() if color_of(r) in KINDS]
    # Newest first by when each entered its state, not by its last event, so running
    # sessions keep their place while they work.
    records.sort(key=lambda r: -(r.get("since") or r.get("updated_at", 0)))
    out = {"counts": {k: 0 for k in KINDS}, "sessions": []}
    for r in records:
        kind = color_of(r)
        out["counts"][kind] += 1
        agent = AGENTS.get(r.get("tool"))
        out["sessions"].append({
            "key": r["_key"], "tool": r.get("tool") or "", "kind": kind,
            "app": agent.label if agent else r.get("tool") or "",
            "bundle": r.get("bundle") or (agent.bundle if agent else ""),
            "reason": r.get("reason") or "", "detail": r.get("detail") or "",
            "name": r.get("name") or r.get("title") or r.get("tool") or "",
            "cwd": r.get("cwd") or "", "updated_at": r.get("since") or r.get("updated_at") or 0,
            "prompt": r.get("prompt") or "",
        })
    print(json.dumps(out, ensure_ascii=False))


def cmd_dump():
    with Lock():
        collect()
        records = all_records()
    print(json.dumps(records, ensure_ascii=False, indent=2))


# ---------------------------------------------------------------- install

def _swiftbar_plugin():
    """Where an older version installed its SwiftBar plugin, if anywhere."""
    try:
        d = subprocess.run(["/usr/bin/defaults", "read", "com.ameba.SwiftBar", "PluginDirectory"],
                           capture_output=True, text=True).stdout.strip()
    except OSError:
        return None
    path = os.path.join(os.path.expanduser(d), "agent-status.1m.sh") if d else None
    return path if path and os.path.exists(path) else None


def _launchctl(*args):
    return subprocess.call(["/bin/launchctl"] + list(args),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def build_app():
    """Compile the menu bar app into build/Agent Status.app. Returns True on success."""
    import shutil
    print("Menu bar app:")
    if not shutil.which("swiftc"):
        print("  swiftc not found. Install the Xcode Command Line Tools (xcode-select --install)\n"
              "  and run install again.")
        return False
    macos = os.path.join(APP, "Contents", "MacOS")
    os.makedirs(macos, exist_ok=True)
    src = sorted(glob.glob(os.path.join(ROOT, "app", "*.swift")))
    if subprocess.call(["swiftc", "-O", "-target", "%s-apple-macos13" % os.uname().machine,
                        "-o", os.path.join(macos, "AgentStatus")] + src) != 0:
        print("  build failed.")
        return False
    with open(os.path.join(ROOT, "app", "Info.plist")) as f:
        plist = f.read()
    with open(os.path.join(APP, "Contents", "Info.plist"), "w") as f:
        f.write(plist)
    # Ad-hoc signature, so macOS treats the bundle as one app.
    subprocess.call(["/usr/bin/codesign", "--force", "--sign", "-", APP],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("  built:  " + APP)
    return True


def start_app():
    """Run the app now and at every login, through a LaunchAgent."""
    exe = os.path.join(APP, "Contents", "MacOS", "AgentStatus")
    os.makedirs(os.path.dirname(LAUNCH_AGENT), exist_ok=True)
    with open(LAUNCH_AGENT, "w") as f:
        f.write("""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>%s</string>
  <key>ProgramArguments</key><array><string>%s</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>AGENT_STATUS_BIN</key><string>%s</string>
    <key>AGENT_STATUS_DIR</key><string>%s</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
""" % (AGENT_LABEL, _xml(exe), _xml(SELF), _xml(STATE_DIR)))
    domain = "gui/%d" % os.getuid()
    _launchctl("bootout", "%s/%s" % (domain, AGENT_LABEL))
    ok = _launchctl("bootstrap", domain, LAUNCH_AGENT) == 0
    print("  %s: %s" % ("started" if ok else "could not start (log out and in, or open the app)",
                        LAUNCH_AGENT))


def stop_app():
    _launchctl("bootout", "gui/%d/%s" % (os.getuid(), AGENT_LABEL))
    if os.path.exists(LAUNCH_AGENT):
        os.remove(LAUNCH_AGENT)
        print("  removed " + LAUNCH_AGENT)


def _xml(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def cmd_install():
    os.makedirs(STATE_DIR, exist_ok=True)
    os.chmod(SELF, 0o755)
    for agent in AGENTS.values():
        print(agent.label + ":")
        if agent.present():
            agent.install()
        else:
            print("  not found; skipped.")
    print()
    if build_app():
        start_app()
    old = _swiftbar_plugin()
    if old:
        os.remove(old)
        print("  removed the old SwiftBar plugin: " + old)
    print("\nDone. New sessions pick up the hooks.")


# ---------------------------------------------------------------- codex trust

def _codex_exe():
    import shutil
    for exe in (shutil.which("codex"), "/opt/homebrew/bin/codex", "/usr/local/bin/codex",
                "/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex"):
        if exe and os.access(exe, os.X_OK):
            return exe
    return None


class _AppServer:
    """Minimal JSON-lines client for `codex app-server`, the API the Codex app itself
    uses to list hooks and record that the user trusts them."""

    def __init__(self, exe):
        self.p = subprocess.Popen([exe, "app-server"], stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.buf = b""
        self.next_id = 0
        self.request("initialize", {"clientInfo": {"name": "agent-status", "version": "0.1"}})
        self._send({"method": "initialized"})

    def _send(self, msg):
        self.p.stdin.write((json.dumps(msg) + "\n").encode())
        self.p.stdin.flush()

    def request(self, method, params, timeout=20):
        import select
        self.next_id += 1
        rid = self.next_id
        self._send({"id": rid, "method": method, "params": params})
        deadline = time.time() + timeout
        while time.time() < deadline:
            while b"\n" in self.buf:
                line, self.buf = self.buf.split(b"\n", 1)
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if msg.get("id") == rid and ("result" in msg or "error" in msg):
                    if "error" in msg:
                        raise RuntimeError("%s failed: %s" % (method, msg["error"]))
                    return msg["result"]
            ready, _, _ = select.select([self.p.stdout], [], [], deadline - time.time())
            if not ready:
                break
            chunk = os.read(self.p.stdout.fileno(), 65536)
            if not chunk:
                break
            self.buf += chunk
        raise RuntimeError("%s: no answer from codex app-server" % method)

    def close(self):
        try:
            self.p.stdin.close()
            self.p.wait(timeout=3)
        except Exception:
            self.p.kill()


def _our_codex_hooks(server):
    hooks = {}
    for group in server.request("hooks/list", {}).get("data", []):
        for h in group.get("hooks", []):
            if HOOK_MARKER in h.get("command", ""):
                hooks[h["key"]] = h
    return list(hooks.values())


def cmd_trust_codex():
    exe = _codex_exe()
    if not exe:
        print("  codex not found; skipping.")
        return 1
    server = _AppServer(exe)
    try:
        hooks = _our_codex_hooks(server)
        pending = [h for h in hooks if h.get("trustStatus") != "trusted"]
        if not hooks:
            print("  No agent-status hooks in Codex yet. Run install first.")
            return 1
        if not pending:
            print("  All %d agent-status hooks are already trusted." % len(hooks))
            return 0
        print("  These hooks run outside Codex's sandbox, on every matching event:")
        for h in pending:
            print("    %-18s %s" % (h["eventName"], h["command"]))
        if not sys.stdin.isatty():
            print("  Run this in a terminal to confirm: %s trust-codex" % _q(SELF))
            return 1
        answer = input("  Trust these %d hooks in Codex? [y/N] " % len(pending)).strip().lower()
        if answer not in ("y", "yes"):
            print("  Not trusted. Codex will skip them until you trust them.")
            return 1
        edits = [{"keyPath": "hooks.state.%s.trusted_hash" % json.dumps(h["key"]),
                  "value": h["currentHash"], "mergeStrategy": "upsert"} for h in pending]
        server.request("config/batchWrite", {"edits": edits, "filePath": None,
                                             "expectedVersion": None, "reloadUserConfig": True})
        after = _our_codex_hooks(server)
        ok = sum(1 for h in after if h.get("trustStatus") == "trusted")
        print("  Trusted %d of %d agent-status hooks." % (ok, len(after)))
        return 0 if ok == len(after) else 1
    finally:
        server.close()


def cmd_uninstall():
    for agent in AGENTS.values():
        print(agent.label + ":")
        agent.uninstall()
    print("Menu bar app:")
    stop_app()
    old = _swiftbar_plugin()
    if old:
        os.remove(old)
        print("  removed the old SwiftBar plugin: " + old)
    print("\nState folder left in place: %s (delete it if you like)." % STATE_DIR)


# ---------------------------------------------------------------- main

def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "hook":
        tool = argv[2] if len(argv) > 2 else "claude"
        event = argv[3] if len(argv) > 3 else ""  # Antigravity doesn't name the event on stdin
        try:
            cmd_hook(tool, sys.stdin.read(), event)
        except Exception:
            pass  # a hook must never break the agent
        agent = AGENTS.get(tool)
        out = agent.hook_output(event) if agent else None
        if out is not None:
            print(json.dumps(out))
        return 0
    if cmd == "open" and len(argv) > 2:
        cmd_open(argv[2])
    elif cmd == "seen-all":
        cmd_seen_all()
    elif cmd == "status":
        cmd_status()
    elif cmd == "dump":
        cmd_dump()
    elif cmd == "install":
        cmd_install()
    elif cmd == "uninstall":
        cmd_uninstall()
    elif cmd == "trust-codex":
        return cmd_trust_codex() or 0
    else:
        print(__doc__.strip())
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
