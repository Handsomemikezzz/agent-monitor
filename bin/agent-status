#!/usr/bin/python3 -IS
"""agent-status: a menu bar light for Claude Code and Codex sessions.

Subcommands
  hook <claude|codex>   called by the agents' hooks; reads the event JSON on stdin
  status                sessions to show, as JSON (what the menu bar app reads)
  dump                  every stored record, as JSON, for debugging
  open <key>            jumps back to a session and marks it seen
  seen-all              marks every finished session as seen
  install / uninstall   adds or removes the hooks and the menu bar app
  trust-codex           asks you, then marks the hooks trusted in Codex

Only the Python standard library is used, so it runs on the system /usr/bin/python3.
"""

import base64
import calendar
import fcntl
import glob
import json
import os
import subprocess
import sys
import time

STATE_DIR = os.path.expanduser(os.environ.get("AGENT_STATUS_DIR", "~/.agent-status"))
SELF = os.path.realpath(__file__)
ROOT = os.path.dirname(os.path.dirname(SELF))
APP = os.path.join(ROOT, "build", "Agent Status.app")
AGENT_LABEL = "io.github.agent-status"
LAUNCH_AGENT = os.path.expanduser("~/Library/LaunchAgents/%s.plist" % AGENT_LABEL)
HOOK_MARKER = "agent-status\" hook"  # how our hook commands are recognised on uninstall

READ_TTL = 5 * 3600        # a grey (finished and seen) session is cleared after this
RUNNING_TTL = 30 * 60      # a running session with no sign of life for this long counts as idle
ATTENTION_TTL = 24 * 3600  # a red or blue session nobody looked at is cleared after this

# What the apps themselves record, read to correct and complete what the hooks saw.
CLAUDE_DESKTOP_SESSIONS = "~/Library/Application Support/Claude/claude-code-sessions"
CLAUDE_PROJECTS = "~/.claude/projects"
CODEX_HOME = os.environ.get("CODEX_HOME", "~/.codex")

CLAUDE_BUNDLE = "com.anthropic.claudefordesktop"
CODEX_BUNDLE = "com.openai.codex"

ASK_TOOLS = {"AskUserQuestion", "ExitPlanMode"}
WAIT_NOTIFICATIONS = {
    "permission_prompt", "worker_permission_prompt",
    "elicitation_dialog", "elicitation_url_dialog", "agent_needs_input",
}

# What each session counts as, in badge order: red, green, blue, grey.
# "read" (finished and seen, or interrupted) is kept on disk but not shown.
KINDS = ("waiting", "running", "unread")
# ---------------------------------------------------------------- state files

def _path(key):
    return os.path.join(STATE_DIR, key + ".json")


def _safe(s):
    return "".join(c if c.isalnum() or c in "-_" else "_" for c in str(s))[:100]


def load(key):
    try:
        with open(_path(key)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save(key, rec):
    tmp = _path(key) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(rec, f, ensure_ascii=False)
    os.replace(tmp, _path(key))


def remove(key):
    try:
        os.remove(_path(key))
    except OSError:
        pass


def all_records():
    out = []
    try:
        names = os.listdir(STATE_DIR)
    except OSError:
        return out
    for name in names:
        if name.endswith(".json"):
            rec = load(name[:-5])
            if rec:
                rec["_key"] = name[:-5]
                out.append(rec)
    return out


class Lock:
    def __enter__(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        self.f = open(os.path.join(STATE_DIR, ".lock"), "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def color_of(rec):
    """What a single session counts as: waiting / running / unread / read."""
    st = rec.get("state")
    if st == "waiting":
        return "waiting"
    if st == "running":
        return "running"
    if st == "done" and not rec.get("seen"):
        return "unread"
    return "read"  # finished and seen, or interrupted


# ---------------------------------------------------------------- hook

def jump_target(tool, sid):
    """Work out, from the hook's environment, how to get back to this session."""
    env = os.environ
    if tool == "claude":
        host = env.get("CLAUDE_CODE_HOST_SESSION_ID", "")
        # Child processes inherit the host id, so also require that this CLI is the
        # one Desktop started, not a `claude` run inside a Desktop session.
        if host.startswith("local_") and env.get("CLAUDE_CODE_ENTRYPOINT") == "claude-desktop":
            return {"kind": "url", "target": "claude://claude.ai/epitaxy/" + host,
                    "fallback": CLAUDE_BUNDLE}
    if tool == "codex":
        # Seen in practice: "Codex Desktop".
        if env.get("CODEX_INTERNAL_ORIGINATOR_OVERRIDE", "").lower().endswith("desktop"):
            return {"kind": "url", "target": "codex://threads/" + sid, "fallback": CODEX_BUNDLE}
    # Started from a terminal: bring that terminal app forward.
    bundle = env.get("__CFBundleIdentifier")
    if bundle:
        return {"kind": "app", "target": bundle}
    return {"kind": "app", "target": CLAUDE_BUNDLE if tool == "claude" else CODEX_BUNDLE}


def next_state(event, data, cur):
    """Return (state, reason) for this event, None to leave it, or 'delete'."""
    st = cur.get("state") if cur else None
    if event == "UserPromptSubmit":
        return ("running", "")
    if event == "SessionStart":
        # Also sent when Desktop resumes an old session or a turn compacts: not a new
        # turn. A session we don't know yet gets its state from its transcript.
        if cur and not cur.get("hidden"):
            return None
        return (st, cur.get("reason", "") if cur else "")
    tool = data.get("tool_name", "")
    if event in ("PreToolUse", "PermissionRequest") and tool in ASK_TOOLS:
        # Claude Desktop sends PermissionRequest for its question tools too.
        return ("waiting", "plan" if tool == "ExitPlanMode" else "question")
    if event == "PermissionRequest":
        return ("waiting", "permission")
    if event == "PreToolUse":
        return None
    if event == "Notification":
        # A fallback only: it follows PermissionRequest and carries less detail.
        if data.get("notification_type") in WAIT_NOTIFICATIONS and st not in ("done", "waiting"):
            return ("waiting", "permission")
        return None
    if event in ("PostToolUse", "PostToolUseFailure"):
        # Clears an approval/question, and shows a running turn is still alive.
        # Never overrides a finished turn.
        if st == "waiting":
            return ("running", "")
        if st == "idle" or (st == "running" and time.time() - cur.get("updated_at", 0) > 60):
            return ("running", "")
        return None
    if event == "Stop":
        return ("done", "")
    if event == "Interrupt":
        return ("idle", "interrupted")
    if event == "SessionEnd":
        return "ended"
    return None


def debug_log(tool, data):
    if not os.path.exists(os.path.join(STATE_DIR, ".debug")):
        return
    keep = {k: (v if k not in ("prompt", "tool_input", "tool_response", "last_assistant_message",
                              "message")
                else "<%d chars>" % len(json.dumps(v, ensure_ascii=False)))
            for k, v in data.items()}
    env = {k: os.environ.get(k) for k in ("CLAUDE_CODE_HOST_SESSION_ID", "CLAUDE_CODE_ENTRYPOINT",
                                         "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
                                         "__CFBundleIdentifier", "TERM_PROGRAM")
           if os.environ.get(k)}
    with open(os.path.join(STATE_DIR, "debug.log"), "a") as f:
        f.write(json.dumps({"t": time.strftime("%H:%M:%S"), "tool": tool, "data": keep,
                            "env": env}, ensure_ascii=False) + "\n")


def cmd_hook(tool):
    raw = sys.stdin.read()
    try:
        data = json.loads(raw) if raw.strip() else {}
    except ValueError:
        return
    os.makedirs(STATE_DIR, exist_ok=True)
    debug_log(tool, data)
    event = data.get("hook_event_name") or data.get("event") or ""
    sid = data.get("session_id") or data.get("thread_id") or ""
    if not sid or not event:
        return
    if tool == "codex" and not data.get("transcript_path"):
        # The Codex app runs short internal sessions of its own (summaries, safety
        # review) that fire hooks too. They have no transcript and no thread you
        # could open, so they aren't yours to track.
        return
    key = "%s-%s" % (tool, _safe(sid))
    with Lock():
        cur = load(key)
        nxt = next_state(event, data, cur)
        if nxt is None:
            return
        if nxt == "ended":
            # Kept, hidden, so the transcript scan doesn't bring it back. Not for
            # Desktop / Codex app sessions: the apps end them on every quit and
            # resume them later; archiving is what really closes them there.
            if cur and (cur.get("jump") or {}).get("kind") == "url":
                return
            if cur and not cur.get("hidden"):
                cur["hidden"] = True
                save(key, cur)
            return
        state, reason = nxt
        rec = dict(cur or {})
        rec.pop("hidden", None)
        if data.get("transcript_path"):
            rec["transcript"] = data["transcript_path"]
        cwd = data.get("cwd") or rec.get("cwd") or ""
        rec.update({
            "tool": tool,
            "session_id": sid,
            "state": state,
            "reason": reason,
            "cwd": cwd,
            "title": os.path.basename(cwd.rstrip("/")) or tool,
            "updated_at": int(time.time()),
        })
        jump = jump_target(tool, sid)
        # A deep link found once is better than a later, vaguer guess.
        if jump["kind"] == "url" or (rec.get("jump") or {}).get("kind") != "url":
            rec["jump"] = jump
        if reason == "permission" and data.get("tool_name"):
            rec["detail"] = data["tool_name"]
        elif state != "waiting":
            rec.pop("detail", None)
        if event == "UserPromptSubmit" and isinstance(data.get("prompt"), str):
            line = data["prompt"].strip().splitlines()[0] if data["prompt"].strip() else ""
            rec["prompt"] = line[:60]
        if state == "done":
            rec["seen"] = False
            rec.pop("seen_at", None)
            if tool == "claude" and _desktop_on_screen(rec):
                rec["seen"], rec["seen_at"] = True, int(time.time())
        elif state in ("running", "idle"):
            rec["seen"] = True
        save(key, rec)


# ---------------------------------------------------------------- what the apps record
#
# Hooks give the live signal, and are the only way to see an approval or a question.
# But a session that hasn't fired a hook since install is invisible to them, and some
# changes send no hook at all (Esc in Claude Code, a denied approval). So every menu
# refresh also reads, for recently active sessions:
#   - the end of the transcript: did the last turn finish, get interrupted, or is it going?
#   - Claude Desktop's session files: title, archived, when you last looked at it
#   - Codex's state database: title, archived, and the app's own read/unread mark

def _iso(ts):
    try:
        return calendar.timegm(time.strptime(str(ts)[:19], "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return 0


def _tail(path, size=256 * 1024):
    """The last lines of a file, newest first."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            n = f.tell()
            f.seek(max(0, n - size))
            lines = f.read().split(b"\n")
    except OSError:
        return []
    return (lines[1:] if n > size else lines)[::-1]


def claude_turn(path):
    """(state, reason, time) of the last turn in a Claude Code transcript, or None."""
    for raw in _tail(path):
        if not raw.strip():
            continue
        try:
            d = json.loads(raw)
        except ValueError:
            continue
        kind, ts = d.get("type"), _iso(d.get("timestamp"))
        if kind == "system":
            if d.get("subtype") in ("stop_hook_summary", "turn_duration"):
                return ("done", "", ts)
        elif kind == "assistant":
            if (d.get("message") or {}).get("stop_reason") in ("end_turn", "stop_sequence"):
                return ("done", "", ts)
            return ("running", "", ts)
        elif kind == "user" and not d.get("isMeta"):
            if b"[Request interrupted by user" in raw:  # Esc, or a denied approval
                return ("idle", "interrupted", ts)
            if b"<local-command-stdout>" in raw:  # a slash command that ran no turn
                continue
            return ("running", "", ts)
    return None


def codex_turn(path):
    """(state, reason, time) of the last turn in a Codex rollout file, or None."""
    for raw in _tail(path):
        if b'"event_msg"' not in raw:
            continue
        try:
            d = json.loads(raw)
        except ValueError:
            continue
        kind, ts = (d.get("payload") or {}).get("type"), _iso(d.get("timestamp"))
        if kind == "task_complete":
            return ("done", "", ts)
        if kind == "turn_aborted":
            return ("idle", "interrupted", ts)
        if kind in ("task_started", "turn_started"):
            return ("running", "", ts)
    return None


def codex_thread_source(path):
    """Who started a Codex thread, from its rollout's first line: "user" for one you
    started, something else for a subagent; "" if the file isn't there yet."""
    try:
        with open(path, "rb") as f:
            meta = json.loads(f.readline())
    except (OSError, ValueError):
        return ""
    p = meta.get("payload") or {}
    if isinstance(p.get("source"), dict) and "subagent" in p["source"]:
        return "subagent"
    return p.get("thread_source") or ""


def desktop_sessions(since):
    """Claude Desktop's own session files, by CLI session id."""
    out = {}
    pattern = os.path.join(os.path.expanduser(CLAUDE_DESKTOP_SESSIONS), "*", "*", "local_*.json")
    for f in glob.glob(pattern):
        try:
            if os.path.getmtime(f) < since:
                continue
            with open(f) as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        if d.get("cliSessionId"):
            out[d["cliSessionId"]] = d
    return out


def _desktop_on_screen(rec):
    """True if this Desktop session is the one on screen right now, so its new
    answer has already been seen."""
    host = ((rec.get("jump") or {}).get("target") or "").rsplit("/", 1)[-1]
    if not host.startswith("local_") or _frontmost() != CLAUDE_BUNDLE:
        return False
    sessions = desktop_sessions(time.time() - ATTENTION_TTL).values()
    focus = {d.get("sessionId"): d.get("lastFocusedAt") or 0 for d in sessions}
    return bool(focus) and focus.get(host, -1) >= max(focus.values())


def _frontmost():
    try:
        asn = subprocess.run(["/usr/bin/lsappinfo", "front"], capture_output=True,
                             text=True, timeout=1).stdout.strip()
        out = subprocess.run(["/usr/bin/lsappinfo", "info", "-only", "bundleid", asn],
                             capture_output=True, text=True, timeout=1).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return out.rsplit("=", 1)[-1].strip().strip('"') or None


def codex_threads(since):
    """Recent threads from Codex's state database, by thread id."""
    import sqlite3
    import urllib.request
    dbs = glob.glob(os.path.join(os.path.expanduser(CODEX_HOME), "state_*.sqlite"))
    if not dbs:
        return {}
    db = max(dbs, key=lambda p: int("".join(c for c in os.path.basename(p) if c.isdigit()) or 0))
    try:
        con = sqlite3.connect("file:%s?mode=ro" % urllib.request.pathname2url(db),
                              uri=True, timeout=1)
        rows = con.execute(
            "SELECT t.id, t.rollout_path, t.cwd, COALESCE(NULLIF(t.name, ''), t.title),"
            " t.archived, t.originator, t.thread_source, r.first_unread_turn"
            " FROM threads t LEFT JOIN thread_read_receipts r ON r.thread_id = t.id"
            " WHERE t.updated_at_ms >= ?", (int(since * 1000),)).fetchall()
        con.close()
    except Exception:  # the schema is Codex's own and may change
        return {}
    return {r[0]: {"rollout": r[1], "cwd": r[2], "title": r[3], "archived": bool(r[4]),
                   "originator": r[5] or "", "source": r[6] or "", "unread": bool(r[7])}
            for r in rows}


def _new_record(tool, sid, cwd):
    return {"tool": tool, "session_id": sid, "state": None, "reason": "", "cwd": cwd or "",
            "title": os.path.basename((cwd or "").rstrip("/")) or tool, "updated_at": 0,
            "seen": True}


def collect():
    """All sessions worth showing, with hook state corrected by what the apps record.
    Writes back what changed. Call with the lock held."""
    now = time.time()
    recs = {r.pop("_key"): r for r in all_records()}
    before = {k: json.dumps(r, sort_keys=True) for k, r in recs.items()}
    extra = {}  # per-session facts for this pass only

    for sid, d in desktop_sessions(now - ATTENTION_TTL).items():
        key = "claude-" + _safe(sid)
        active = (d.get("lastActivityAt") or 0) / 1000
        if key not in recs:
            if d.get("isArchived") or active < now - READ_TTL:
                continue
            rec = recs[key] = _new_record("claude", sid, d.get("cwd"))
            found = glob.glob(os.path.join(os.path.expanduser(CLAUDE_PROJECTS), "*", sid + ".jsonl"))
            if found:
                rec["transcript"] = found[0]
        rec = recs[key]
        rec["jump"] = {"kind": "url", "target": "claude://claude.ai/epitaxy/" + d["sessionId"],
                       "fallback": CLAUDE_BUNDLE}
        if d.get("title"):
            rec["name"] = d["title"]
        if d.get("isArchived"):
            rec["hidden"] = True
        extra[key] = {"focused": (d.get("lastFocusedAt") or 0) / 1000}

    for tid, t in codex_threads(now - ATTENTION_TTL).items():
        key = "codex-" + _safe(tid)
        if key not in recs:
            if t["archived"] or t["source"] != "user" or t["originator"] == "codex_exec":
                continue
            recs[key] = _new_record("codex", tid, t["cwd"])
        rec = recs[key]
        if t["rollout"]:
            rec.setdefault("transcript", t["rollout"])
        if t["title"]:
            rec["name"] = t["title"].strip().splitlines()[0]
        if t["archived"]:
            rec["hidden"] = True
        if t["originator"] == "Codex Desktop":
            rec["jump"] = {"kind": "url", "target": "codex://threads/" + tid,
                           "fallback": CODEX_BUNDLE}
            extra[key] = {"read": not t["unread"]}

    for key in list(recs):
        rec = recs[key]
        if rec.get("tool") == "codex":
            if not rec.get("transcript"):
                # Left by an internal Codex app session (see cmd_hook): drop it.
                remove(key)
                del recs[key]
                continue
            if not rec.get("thread_source"):  # retried until the rollout file exists
                rec["thread_source"] = codex_thread_source(rec["transcript"])
            if rec["thread_source"] not in ("user", ""):
                rec["hidden"] = True  # a subagent's thread, not one you started

    for key, rec in recs.items():
        path = rec.get("transcript")
        mtime = os.path.getmtime(path) if path and os.path.exists(path) else 0
        turn = (claude_turn if rec.get("tool") == "claude" else codex_turn)(path) if mtime else None
        # The transcript wins only when it's newer than the last hook event; the
        # hook stays the authority on approvals and questions.
        if turn and (rec.get("state") is None or turn[2] > rec.get("updated_at", 0) + 2):
            state, reason, ts = turn
            if state != rec.get("state"):
                rec["state"], rec["reason"] = state, reason
                rec.pop("detail", None)
                rec["seen"] = state != "done"  # a finish the hooks missed is still news
                rec.pop("seen_at", None)
                # The time it really happened, not when a later hook (say, Desktop
                # resuming an old session) first told us about the session.
                rec["updated_at"] = ts
            else:
                rec["updated_at"] = max(rec.get("updated_at", 0), ts)
        if rec.get("state") is None:
            rec["state"] = "idle"
            rec["updated_at"] = int(mtime or now)
        # You looked at it in the app after it finished.
        x = extra.get(key, {})
        if rec["state"] == "done" and not rec.get("seen"):
            if x.get("focused", 0) >= rec.get("updated_at", 0) or x.get("read"):
                rec["seen"], rec["seen_at"] = True, int(now)
        if rec["state"] == "running" and now - max(rec.get("updated_at", 0), mtime) > RUNNING_TTL:
            # Nothing has happened for a long time: the process probably went away.
            rec["state"], rec["reason"] = "idle", ""

    shown = []
    for key, rec in recs.items():
        kind = color_of(rec)
        age = now - max(rec.get("updated_at", 0), rec.get("seen_at", 0))
        ttl = READ_TTL if rec.get("hidden") or kind in ("read", "running") else ATTENTION_TTL
        if age > ttl:
            remove(key)
            continue
        if json.dumps(rec, sort_keys=True) != before.get(key):
            save(key, rec)
        if not rec.get("hidden"):
            rec["_key"] = key
            shown.append(rec)
    return shown


def _q(s):
    return '"%s"' % str(s).replace('"', "'")


# ---------------------------------------------------------------- actions

def _activate(bundle):
    """Bring an app to the front. `open -b` alone may leave it behind the current app."""
    script = 'tell application id "%s" to activate' % bundle
    if subprocess.call(["/usr/bin/osascript", "-e", script],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
        return True
    return subprocess.call(["/usr/bin/open", "-b", bundle]) == 0


def cmd_open(key):
    with Lock():
        rec = load(key)
        if not rec:
            return
        if rec.get("state") == "done" and not rec.get("seen"):
            rec["seen"], rec["seen_at"] = True, int(time.time())
            save(key, rec)
    jump = rec.get("jump") or {}
    default = CLAUDE_BUNDLE if rec.get("tool") == "claude" else CODEX_BUNDLE
    if jump.get("kind") == "url":
        # The deep link switches the app to the session; then bring the app forward.
        subprocess.call(["/usr/bin/open", jump["target"]])
        _activate(jump.get("fallback") or default)
    elif jump.get("kind") == "app":
        if not _activate(jump["target"]):
            _activate(default)
    else:
        _activate(default)


def cmd_seen_all():
    with Lock():
        for r in all_records():
            if r.get("state") == "done" and not r.get("seen"):
                r["seen"], r["seen_at"] = True, int(time.time())
                save(r.pop("_key"), r)


def cmd_status():
    """The sessions to show and how many of each kind. The menu bar app reads this."""
    with Lock():
        records = [r for r in collect() if color_of(r) in KINDS]
    records.sort(key=lambda r: -r.get("updated_at", 0))
    out = {"counts": {k: 0 for k in KINDS}, "sessions": []}
    for r in records:
        kind = color_of(r)
        out["counts"][kind] += 1
        out["sessions"].append({
            "key": r["_key"], "tool": r.get("tool") or "", "kind": kind,
            "reason": r.get("reason") or "", "detail": r.get("detail") or "",
            "name": r.get("name") or r.get("title") or r.get("tool") or "",
            "cwd": r.get("cwd") or "", "updated_at": r.get("updated_at") or 0,
            "prompt": r.get("prompt") or "",
        })
    print(json.dumps(out, ensure_ascii=False))


def cmd_dump():
    with Lock():
        collect()
        records = all_records()
    print(json.dumps(records, ensure_ascii=False, indent=2))


# ---------------------------------------------------------------- install

CLAUDE_EVENTS = [
    ("SessionStart", None), ("UserPromptSubmit", None),
    ("PreToolUse", "AskUserQuestion|ExitPlanMode"), ("PermissionRequest", None),
    ("Notification", "|".join(sorted(WAIT_NOTIFICATIONS))),
    ("PostToolUse", None), ("PostToolUseFailure", None),
    ("Stop", None), ("SessionEnd", None),
]
CODEX_EVENTS = [
    ("SessionStart", None), ("UserPromptSubmit", None), ("PermissionRequest", None),
    ("PostToolUse", None), ("Stop", None), ("Interrupt", None), ("SessionEnd", None),
]


def _hook_cmd(tool):
    return '"%s" hook %s' % (SELF, tool)


def _strip_ours(hooks):
    """Remove our entries from a hooks mapping, leaving everybody else's untouched."""
    for event in list(hooks):
        groups = []
        for g in hooks[event]:
            inner = [h for h in g.get("hooks", []) if HOOK_MARKER not in h.get("command", "")]
            if inner:
                g = dict(g, hooks=inner)
                groups.append(g)
            elif not g.get("hooks"):
                groups.append(g)
        if groups:
            hooks[event] = groups
        else:
            del hooks[event]


def _edit_json(path, fn):
    data = {}
    if os.path.exists(path):
        with open(path) as f:
            text = f.read()
        data = json.loads(text) if text.strip() else {}
        backup = "%s.bak-agent-status-%s" % (path, time.strftime("%Y%m%d-%H%M%S"))
        with open(backup, "w") as f:
            f.write(text)
        print("  backup: " + backup)
    fn(data)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, path)
    print("  wrote:  " + path)


def _install_hooks(path, tool, events):
    def fn(data):
        hooks = data.setdefault("hooks", {})
        _strip_ours(hooks)
        for event, matcher in events:
            group = {"hooks": [{"type": "command", "command": _hook_cmd(tool), "timeout": 3}]}
            if matcher:
                group = dict({"matcher": matcher}, **group)
            hooks.setdefault(event, []).append(group)
    _edit_json(path, fn)


def _uninstall_hooks(path):
    if not os.path.exists(path):
        return

    def fn(data):
        _strip_ours(data.get("hooks", {}))
        if data.get("hooks") == {}:
            del data["hooks"]
    _edit_json(path, fn)


def _swiftbar_plugin():
    """Where an older version installed its SwiftBar plugin, if anywhere."""
    try:
        d = subprocess.run(["/usr/bin/defaults", "read", "com.ameba.SwiftBar", "PluginDirectory"],
                           capture_output=True, text=True).stdout.strip()
    except OSError:
        return None
    path = os.path.join(os.path.expanduser(d), "agent-status.1m.sh") if d else None
    return path if path and os.path.exists(path) else None


def _launchctl(*args):
    return subprocess.call(["/bin/launchctl"] + list(args),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def build_app():
    """Compile the menu bar app into build/Agent Status.app. Returns True on success."""
    import shutil
    print("Menu bar app:")
    if not shutil.which("swiftc"):
        print("  swiftc not found. Install the Xcode Command Line Tools (xcode-select --install)\n"
              "  and run install again.")
        return False
    macos = os.path.join(APP, "Contents", "MacOS")
    os.makedirs(macos, exist_ok=True)
    src = sorted(glob.glob(os.path.join(ROOT, "app", "*.swift")))
    if subprocess.call(["swiftc", "-O", "-target", "%s-apple-macos13" % os.uname().machine,
                        "-o", os.path.join(macos, "AgentStatus")] + src) != 0:
        print("  build failed.")
        return False
    with open(os.path.join(ROOT, "app", "Info.plist")) as f:
        plist = f.read()
    with open(os.path.join(APP, "Contents", "Info.plist"), "w") as f:
        f.write(plist)
    # Ad-hoc signature, so macOS treats the bundle as one app.
    subprocess.call(["/usr/bin/codesign", "--force", "--sign", "-", APP],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("  built:  " + APP)
    return True


def start_app():
    """Run the app now and at every login, through a LaunchAgent."""
    exe = os.path.join(APP, "Contents", "MacOS", "AgentStatus")
    os.makedirs(os.path.dirname(LAUNCH_AGENT), exist_ok=True)
    with open(LAUNCH_AGENT, "w") as f:
        f.write("""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>%s</string>
  <key>ProgramArguments</key><array><string>%s</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>AGENT_STATUS_BIN</key><string>%s</string>
    <key>AGENT_STATUS_DIR</key><string>%s</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
""" % (AGENT_LABEL, _xml(exe), _xml(SELF), _xml(STATE_DIR)))
    domain = "gui/%d" % os.getuid()
    _launchctl("bootout", "%s/%s" % (domain, AGENT_LABEL))
    ok = _launchctl("bootstrap", domain, LAUNCH_AGENT) == 0
    print("  %s: %s" % ("started" if ok else "could not start (log out and in, or open the app)",
                        LAUNCH_AGENT))


def stop_app():
    _launchctl("bootout", "gui/%d/%s" % (os.getuid(), AGENT_LABEL))
    if os.path.exists(LAUNCH_AGENT):
        os.remove(LAUNCH_AGENT)
        print("  removed " + LAUNCH_AGENT)


def _xml(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def cmd_install():
    os.makedirs(STATE_DIR, exist_ok=True)
    os.chmod(SELF, 0o755)
    print("Claude Code:")
    _install_hooks(os.path.expanduser("~/.claude/settings.json"), "claude", CLAUDE_EVENTS)
    print("Codex:")
    _install_hooks(os.path.expanduser("~/.codex/hooks.json"), "codex", CODEX_EVENTS)
    if build_app():
        start_app()
    old = _swiftbar_plugin()
    if old:
        os.remove(old)
        print("  removed the old SwiftBar plugin: " + old)
    print("\nCodex trust:")
    if sys.stdin.isatty() and _codex_exe():
        cmd_trust_codex()
    else:
        print("  Codex runs new hooks only after you trust them. Run:\n"
              "    %s trust-codex\n"
              "  or open Codex → Settings → Hooks → Review hooks." % _q(SELF))
    print("\nDone. New Claude Code / Codex sessions pick up the hooks.")


# ---------------------------------------------------------------- codex trust

def _codex_exe():
    import shutil
    for exe in (shutil.which("codex"), "/opt/homebrew/bin/codex", "/usr/local/bin/codex",
                "/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex"):
        if exe and os.access(exe, os.X_OK):
            return exe
    return None


class _AppServer:
    """Minimal JSON-lines client for `codex app-server`, the API the Codex app itself
    uses to list hooks and record that the user trusts them."""

    def __init__(self, exe):
        self.p = subprocess.Popen([exe, "app-server"], stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.buf = b""
        self.next_id = 0
        self.request("initialize", {"clientInfo": {"name": "agent-status", "version": "0.1"}})
        self._send({"method": "initialized"})

    def _send(self, msg):
        self.p.stdin.write((json.dumps(msg) + "\n").encode())
        self.p.stdin.flush()

    def request(self, method, params, timeout=20):
        import select
        self.next_id += 1
        rid = self.next_id
        self._send({"id": rid, "method": method, "params": params})
        deadline = time.time() + timeout
        while time.time() < deadline:
            while b"\n" in self.buf:
                line, self.buf = self.buf.split(b"\n", 1)
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if msg.get("id") == rid and ("result" in msg or "error" in msg):
                    if "error" in msg:
                        raise RuntimeError("%s failed: %s" % (method, msg["error"]))
                    return msg["result"]
            ready, _, _ = select.select([self.p.stdout], [], [], deadline - time.time())
            if not ready:
                break
            chunk = os.read(self.p.stdout.fileno(), 65536)
            if not chunk:
                break
            self.buf += chunk
        raise RuntimeError("%s: no answer from codex app-server" % method)

    def close(self):
        try:
            self.p.stdin.close()
            self.p.wait(timeout=3)
        except Exception:
            self.p.kill()


def _our_codex_hooks(server):
    hooks = {}
    for group in server.request("hooks/list", {}).get("data", []):
        for h in group.get("hooks", []):
            if HOOK_MARKER in h.get("command", ""):
                hooks[h["key"]] = h
    return list(hooks.values())


def cmd_trust_codex():
    exe = _codex_exe()
    if not exe:
        print("  codex not found; skipping.")
        return 1
    server = _AppServer(exe)
    try:
        hooks = _our_codex_hooks(server)
        pending = [h for h in hooks if h.get("trustStatus") != "trusted"]
        if not hooks:
            print("  No agent-status hooks in Codex yet. Run install first.")
            return 1
        if not pending:
            print("  All %d agent-status hooks are already trusted." % len(hooks))
            return 0
        print("  These hooks run outside Codex's sandbox, on every matching event:")
        for h in pending:
            print("    %-18s %s" % (h["eventName"], h["command"]))
        if not sys.stdin.isatty():
            print("  Run this in a terminal to confirm: %s trust-codex" % _q(SELF))
            return 1
        answer = input("  Trust these %d hooks in Codex? [y/N] " % len(pending)).strip().lower()
        if answer not in ("y", "yes"):
            print("  Not trusted. Codex will skip them until you trust them.")
            return 1
        edits = [{"keyPath": "hooks.state.%s.trusted_hash" % json.dumps(h["key"]),
                  "value": h["currentHash"], "mergeStrategy": "upsert"} for h in pending]
        server.request("config/batchWrite", {"edits": edits, "filePath": None,
                                             "expectedVersion": None, "reloadUserConfig": True})
        after = _our_codex_hooks(server)
        ok = sum(1 for h in after if h.get("trustStatus") == "trusted")
        print("  Trusted %d of %d agent-status hooks." % (ok, len(after)))
        return 0 if ok == len(after) else 1
    finally:
        server.close()


def cmd_uninstall():
    print("Claude Code:")
    _uninstall_hooks(os.path.expanduser("~/.claude/settings.json"))
    print("Codex:")
    _uninstall_hooks(os.path.expanduser("~/.codex/hooks.json"))
    print("Menu bar app:")
    stop_app()
    old = _swiftbar_plugin()
    if old:
        os.remove(old)
        print("  removed the old SwiftBar plugin: " + old)
    print("\nState folder left in place: %s (delete it if you like)." % STATE_DIR)


# ---------------------------------------------------------------- main

def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "hook":
        try:
            cmd_hook(argv[2] if len(argv) > 2 else "claude")
        except Exception:
            pass  # a hook must never break the agent
        return 0
    if cmd == "open" and len(argv) > 2:
        cmd_open(argv[2])
    elif cmd == "seen-all":
        cmd_seen_all()
    elif cmd == "status":
        cmd_status()
    elif cmd == "dump":
        cmd_dump()
    elif cmd == "install":
        cmd_install()
    elif cmd == "uninstall":
        cmd_uninstall()
    elif cmd == "trust-codex":
        return cmd_trust_codex() or 0
    else:
        print(__doc__.strip())
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
